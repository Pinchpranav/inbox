# Production build config for the OpenClaw inbox app.
# Committed on purpose (no secrets) — Vite loads this automatically during
# `vite build` (mode=production) and inlines VITE_GATEWAY_URL into the bundle.
#
# The gateway URL is a relative path so the app stays same-origin with the
# gateway regardless of the deployed domain (inbox.pranavself.uk). The inbox
# nginx serves the app at / and proxies /gw/ to the openclaw gateway container.
VITE_GATEWAY_URL=/gw

# The token is deliberately NOT baked into the bundle (security). The user
# pastes it once per device in the in-app ⚙ Settings panel; it's the gateway
# bearer token (the value of OPENCLAW_GATEWAY_TOKEN on the gateway).
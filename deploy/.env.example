# Copy this file to deploy/.env (gitignored). It is sourced by deploy/start.sh
# and deploy/backend.sh so the backend pane gets the same env.

# REQUIRED for chat streaming (the backend registers the ollama-cloud provider).
OLLAMA_API_KEY=your-ollama-cloud-api-key

# Optional overrides (defaults shown):
# PORT=8787                     # backend listen port
# INBOX_BACKEND=localhost:8787  # what nginx proxies /api to
# INBOX_LISTEN=127.0.0.1:8085   # our nginx listener (loopback; avoids Coolify's :80)
# INBOX_DB=.inbox/inbox.db      # sqlite path (relative to repo root)
# INBOX_AGENT_DIR=              # isolated pi config dir; default = repo root
